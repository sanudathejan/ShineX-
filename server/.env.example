# Copy this file to .env and fill in the values below.
# .env is gitignored — never commit real credentials.

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Must match the origin your frontend runs on (Vite's default dev server)
CORS_ORIGIN=http://localhost:5173

# ── Firebase Admin SDK ──────────────────────────────────
# This is NOT the same config as src/config/firebase.js (that's the public
# web config for the browser). The Admin SDK needs a service account key:
#   Firebase Console → Project Settings → Service Accounts → Generate New Private Key
#
# Option A (recommended for local dev): save the downloaded JSON as
#   server/serviceAccountKey.json  (already gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option B (for hosts without file storage, e.g. some PaaS deploys): paste
# the entire JSON as a single-line string instead, and remove the line above.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...", ...}

# ── Email notifications ─────────────────────────────────
# Sends booking/contact notifications via Resend's HTTPS API (not raw SMTP —
# some networks, university ones especially, block outbound SMTP ports
# entirely; HTTPS isn't affected by that).
#
# Get a key: resend.com → sign up → API Keys → Create API Key.
RESEND_API_KEY=re_your_api_key_here
#
# shinex.best is verified in Resend (Dashboard → Domains → DKIM/SPF/DMARC
# records added at Cloudflare), so this can send to any customer address —
# not just the account's own email. If you're setting this up fresh on an
# unverified domain, Resend runs in sandbox mode instead: emails can only be
# sent FROM onboarding@resend.dev, and only TO the account's own email —
# use that as RESEND_FROM_EMAIL temporarily until your domain is verified.
RESEND_FROM_EMAIL=notifications@shinex.best

# reviews.shinex@gmail.com is the only inbox used site-wide — both booking
# and contact notifications land here.
BOOKING_NOTIFY_EMAIL=reviews.shinex@gmail.com
CONTACT_NOTIFY_EMAIL=reviews.shinex@gmail.com
