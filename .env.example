# Copy to .env if you need to override the default.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Where the frontend sends API requests (see src/config/api.js).
# Defaults to http://localhost:5000/api if unset — only needed once you're
# pointing at a deployed backend instead of your local server/.
VITE_API_URL=http://localhost:5000/api

# Powers the interactive map on the booking form's location picker (src/pages/Book.jsx).
# Get one: console.cloud.google.com → same project as Firebase → enable
# "Maps JavaScript API" → set up billing (free tier: ~28,000 loads/month) →
# APIs & Services → Credentials → Create API Key.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
